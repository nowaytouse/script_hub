#!name=🛡️ PROMAX AdBlock Helper (DNS & Firewall)
#!desc=[🚀SR] 保留已有 DNS 与 DoH 设置。将指定局域网名称、设备入口和私网反查交给当前系统 DNS，并排除 Apple 关键服务和加密 DNS 的 MITM。不改分流；需要 AliDNS 时另启用 AliDNS DoH 模块。附带高级端口过滤；开发、矿池、IRC 等场景请按需启用。
#!author=ScriptHub
#!category=『 🔝 Head Expanse › 首端扩域 』
#!tag=AdBlock, DNS, Apple Safety
#!version=2026.11.05

[Rule]
# --- SYNCED PORT RULES START ---
# Automated update from ports source
DEST-PORT,1025,REJECT-DROP   # 常被 Windows RAT 占用
DEST-PORT,1026,REJECT-DROP   # Windows messenger spam / RAT
