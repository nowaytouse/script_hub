#!name=🌟 AdBlock Helper
#!desc=[🚀SR] 追加 AliDNS DoH 与双栈引导；系统解析仅用于局域网域名和设备入口。保留 Apple 关键服务与加密 DNS 的 MITM 排除，不改分流策略。
#!author=ScriptHub
#!category=『 🔝 Head Expanse › 首端扩域 』
#!tag=AdBlock, DNS, Apple Safety
#!version=2026.11.05

[General]
fallback-dns-server = %APPEND% https://dns.alidns.com/dns-query

[Host]
*.home.arpa = server:system
*.lan = server:system
*.local = server:system
*.localdomain = server:system
*.localhost = server:system
aplogin.com = server:system
aplogin.net = server:system
dns.alidns.com = 223.5.5.5, 223.6.6.6, 2400:3200::1, 2400:3200:baba::1
falogin.cn = server:system
fritz.box = server:system
home.arpa = server:system
local = server:system
localhost = server:system
melogin.cn = server:system
miwifi.com = server:system
orbilogin.com = server:system
orbilogin.net = server:system
router.asus.com = server:system
routerlogin.com = server:system
routerlogin.net = server:system
tendawifi.com = server:system
tplinkap.net = server:system
tplinkdeco.net = server:system
tplinklogin.net = server:system
tplinkmifi.net = server:system
tplinkmodem.net = server:system
tplinkplc.net = server:system
tplinkrepeater.net = server:system
tplinkwifi.net = server:system
tplogin.cn = server:system
www.asusrouter.com = server:system
www.miwifi.com = server:system
www.routerlogin.com = server:system
www.routerlogin.net = server:system

[MITM]
hostname = %INSERT% -*.apple, -*.apple-cloudkit.com, -*.apple-dns.net, -*.apple-livephotoskit.com, -*.apzones.com, -*.cdn-apple.com, -*.gc.apple.com, -*.icloud-content.com, -*.icloud.apple.com, -*.icloud.com, -*.icloud.com.cn, -*.iwork.apple.com, -*.music.apple.com, -account.apple.com, -aod-ssl.itunes.apple.com, -aod.itunes.apple.com, -apple, -apple-cloudkit.com, -apple-dns.net, -apple-livephotoskit.com, -apple-native-relay.apple.com, -appleid.cdn-apple.com, -apzones.com, -audio-ssl.itunes.apple.com, -audio.itunes.apple.com, -cdn-apple.com, -certs.apple.com, -cloudflare-dns.com, -crl.apple.com, -dns.alidns.com, -dns.google, -dns.quad9.net, -gateway.icloud.com, -gc.apple.com, -gsa.apple.com, -icloud-content.com, -icloud.apple.com, -icloud.com, -icloud.com.cn, -idmsa.apple.com, -iwork.apple.com, -known-issues.apple.com, -mask-api.icloud.com, -mask-h2.icloud.com, -mask.icloud.com, -metrics.icloud.com, -music.apple.com, -ocsp.apple.com, -ocsp2.apple.com, -pong.icloud.com, -probe.icloud.com, -valid.apple.com, -weather-analytics-events.apple.com
