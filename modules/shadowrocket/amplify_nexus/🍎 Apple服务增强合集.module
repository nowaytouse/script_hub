#!name=🍎 Apple服务增强合集
#!desc=[🚀SR] 仅 Apple TV 官方支持的功能；不含 News、MapKit 或天气改写，不改分流。
#!author=VirgilClyne[https://github.com/VirgilClyne], ScriptHub
#!homepage=https://nsringo.github.io/guide/apple-tv.html
#!category=『 🌐 Amplify Nexus › 增益中枢 』
#!tag=Apple, TV
# Source: https://github.com/NSRingo/TV/releases/latest/download/iRingo.TV.srmodule

[URL Rewrite]
^https:\/\/play-cdn\.itunes\.apple\.com(?::443)?([/?].*)?$ https://play.itunes.apple.com$1 header
^https:\/\/play-edge-cdn\.itunes\.apple\.com(?::443)?([/?].*)?$ https://play-edge.itunes.apple.com$1 header

[Script]
📺 TV.uts.request = type=http-request, pattern=^https?:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\/, requires-body=1, script-path=https://github.com/NSRingo/TV/releases/download/v3.4.4/request.bundle.js, argument=
📺 TV.uts.response = type=http-response, pattern=^https?:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\/, requires-body=1, script-path=https://github.com/NSRingo/TV/releases/download/v3.4.4/response.bundle.js, argument=
📺 TV.umc.request = type=http-request, pattern=^https?:\/\/umc-tempo-api\.apple\.com\/(v1|v2|v3)\/, requires-body=1, script-path=https://github.com/NSRingo/TV/releases/download/v3.4.4/request.bundle.js, argument=

[MITM]
hostname = %APPEND% uts-api.itunes.apple.com, umc-tempo-api.apple.com, play-cdn.itunes.apple.com, play-edge-cdn.itunes.apple.com
