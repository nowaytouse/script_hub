#!name=🍎 Apple服务增强合集
#!desc=整合 WeatherKit · News · TV；默认使用 Apple 原生天气数据，路由由外部规则集与用户策略决定\n\n【Bundled Modules】\n✦  iRingo: 🌤 WeatherKit: iOS 18 & macOS 15 & watchOS 11\n1.解锁全部天气功能\n2.修改空气质量数据\n3.修改下一小时降水数据\n4.修改天气数据\n5.修改天气预警数据\n\n✦  iRingo: 📰 News: 1.自定义解锁News的地区\n2.Coming Soon…\n\n✦  iRingo: 📺 TV app: 全面自定义「TV app」功能
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=https://developer.apple.com/assets/elements/icons/sf-symbols/sf-symbols-128x128.png
#!category=『 🛠️ Amplify Nexus › 增幅枢纽 』
#!date=2026-11-05 11:30:57
#!arguments=DataSets:"currentWeather,forecastDaily,forecastHourly,forecastNextHour,weatherAlerts",Weather.Provider:"WeatherKit",WeatherAlerts.Provider:"WeatherKit",NextHour.Provider:"WeatherKit",AirQuality.Current.Pollutants.Provider:"ColorfulClouds",AirQuality.Calculate.Algorithm:"None",API.ColorfulClouds.Token:"",API.QWeather.Host:"devapi.qweather.com",API.QWeather.Token:"",API.WAQI.Token:"",Storage:"Argument",LogLevel:"WARN",CountryCode:"US",NewsPlusUser:true,ThirdParty:false,isWorkaroundSSLPinning:false
#!arguments-desc=[ iRingo: 🌤 WeatherKit]\nDataSets: [数据集]\n    ├ airQuality: 空气质量\n    ├ currentWeather: 当前天气\n    ├ forecastDaily: 每日预报\n    ├ forecastHourly: 每小时预报\n    ├ forecastNextHour: 未来一小时降水强度\n    └ weatherAlerts: 天气预警\n选择需要解析并处理的数据集；未选择的数据槽始终保持原样透传，不作修改。\n\nWeather.Provider: [天气] 数据源\n    ├ WeatherKit: WeatherKit（不替换）\n    ├ ColorfulClouds: 彩云天气\n    └ QWeather: 和风天气\n使用选定的数据源替换天气数据。\n\nWeatherAlerts.Provider: [天气预警] 数据源\n    ├ WeatherKit: WeatherKit（不修改）\n    ├ QWeatherWeb: 和风天气网页\n    ├ QWeather: 和风天气 API\n    └ ColorfulClouds: 彩云天气 API\n使用选定的数据源处理天气预警数据。\n\nNextHour.Provider: [未来一小时降水强度] 数据源\n    ├ WeatherKit: WeatherKit（不添加）\n    ├ ColorfulClouds: 彩云天气\n    └ QWeather: 和风天气\n使用选定的数据源填充未来一小时降水强度的数据。\n\nAirQuality.Current.Pollutants.Provider: [今日污染物] 数据源\n    ├ ColorfulClouds: 彩云天气\n    └ QWeather: 和风天气\n使用选定的数据源填补污染物数据。\n\nAirQuality.Calculate.Algorithm: [iRingo内置算法] 算法\n    ├ None: 不转换\n    ├ UBA: 德国LQI（FB001846）\n    ├ EU_EAQI: 欧盟EAQI（ETC HE Report 2024/17）\n    ├ WAQI_InstantCast_US: 美标InstantCast（EPA-454/B-24-002）\n    ├ WAQI_InstantCast_CN: 国标InstantCast（HJ 633—2012）\n    ├ WAQI_InstantCast_CN_25_DRAFT: 国标InstantCast（HJ 633 2025年草案）\n    ├ CA_AQHI: 加拿大AQHI（10.17269/s41997-019-00237-w）\n    ├ HK_AQHI: 香港AQHI\n    ├ AQHI_Multi_CN: AQHI-Multi（中国）\n    ├ AQHI_Multi_CN_HK: AQHI-Multi（中国+香港）\n    ├ CN_DEATH_AQHI: 中国（致死风险）AQHI\n    └ CN_DEATH_HK_AQHI: 中国（致死风险）+香港AQHI\n使用内置算法，通过污染物数据本地计算空气指数。InstantCast源自于WAQI，美标版本使用了WAQI的臭氧标准。\n\nAPI.ColorfulClouds.Token: [API] 彩云天气令牌\n彩云天气 API 令牌\n\nAPI.QWeather.Host: [API] 和风天气主机\n和风天气 API 使用的主机名\n\nAPI.QWeather.Token: [API] 和风天气令牌\n和风天气 API 令牌\n\nAPI.WAQI.Token: [API] WAQI 令牌\nWAQI API 令牌，填写此字段将自动使用WAQI高级API\n\nStorage: [储存] 配置类型\n    ├ Argument: 优先使用插件选项与模块参数等，由 $argument 传入的配置，$argument 不包含的设置项由 PersistentStore (BoxJs) 提供\n    ├ PersistentStore: 只使用来自 BoxJs 等，由 $persistentStore 提供的配置\n    └ database: 只使用由作者的 database.mjs 文件提供的默认配置，其他任何自定义配置不再起作用\n选择要使用的配置类型。未设置此选项或不通过此选项的旧版本的配置顺序依旧是 $persistentStore (BoxJs) > $argument > database。\n\nLogLevel: [调试] 日志等级\n    ├ OFF: 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。\n\n\n[ iRingo: 📰 News]\nProxy: News 分流规则使用的策略名\nCountryCode: 国家或地区代码\n    ├ AUTO: 🇺🇳自动（跟随地区检测结果）\n    ├ CN: 🇨🇳中国大陆\n    ├ HK: 🇭🇰香港\n    ├ TW: 🇹🇼台湾\n    ├ SG: 🇸🇬新加坡\n    ├ US: 🇺🇸美国\n    ├ JP: 🇯🇵日本\n    ├ AU: 🇦🇺澳大利亚\n    ├ GB: 🇬🇧英国\n    ├ KR: 🇰🇷…\n(see upstream docs for full details)
#!homepage=https://NSRingo.github.io
# Upstream modules merged by Script Hub (Rust)
# - iRingo.WeatherKit: https://github.com/NSRingo/WeatherKit/releases/latest/download/iRingo.WeatherKit.sgmodule
# - iRingo.News: https://github.com/NSRingo/News/releases/latest/download/iRingo.News.sgmodule
# - iRingo.TV: https://github.com/NSRingo/TV/releases/latest/download/iRingo.TV.sgmodule

[URL Rewrite]
^https:\/\/play-cdn\.itunes\.apple\.com(?::443)?([/?].*)?$ https://play.itunes.apple.com$1 header
^https:\/\/play-edge-cdn\.itunes\.apple\.com(?::443)?([/?].*)?$ https://play-edge.itunes.apple.com$1 header

[Script]
🌤 WeatherKit.api.v1.availability.response = type=http-response, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/", requires-body=1, engine=webview, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v3.3.2/response.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather.Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality.Current.Pollutants.Provider}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality.Calculate.Algorithm}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&API.QWeather.Host="{{{API.QWeather.Host}}}"&API.QWeather.Token="{{{API.QWeather.Token}}}"&API.WAQI.Token="{{{API.WAQI.Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
🌤 WeatherKit.api.v1.airQualityScale.request = type=http-request, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/", engine=webview, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v3.3.2/request.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather.Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality.Current.Pollutants.Provider}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality.Calculate.Algorithm}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&API.QWeather.Host="{{{API.QWeather.Host}}}"&API.QWeather.Token="{{{API.QWeather.Token}}}"&API.WAQI.Token="{{{API.WAQI.Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
🌤 WeatherKit.api.v1.weatherAlerts.html.request = type=http-request, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=[^&#]*-[0-9]{9}(?:&|$)", script-path=https://github.com/NSRingo/WeatherKit/releases/download/v3.3.2/request.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather.Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality.Current.Pollutants.Provider}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality.Calculate.Algorithm}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&API.QWeather.Host="{{{API.QWeather.Host}}}"&API.QWeather.Token="{{{API.QWeather.Token}}}"&API.WAQI.Token="{{{API.WAQI.Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
🌤 WeatherKit.api.v1.weatherAlerts.api.request = type=http-request, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=-?[0-9]+(?:\.[0-9]+)?,-?[0-9]+(?:\.[0-9]+)?(?:&|$)", script-path=https://github.com/NSRingo/WeatherKit/releases/download/v3.3.2/request.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather.Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality.Current.Pollutants.Provider}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality.Calculate.Algorithm}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&API.QWeather.Host="{{{API.QWeather.Host}}}"&API.QWeather.Token="{{{API.QWeather.Token}}}"&API.WAQI.Token="{{{API.WAQI.Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
🌤 WeatherKit.api.v2.weather.response = type=http-response, pattern="^https:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/", requires-body=1, binary-body-mode=1, engine=webview, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v3.3.2/response.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather.Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality.Current.Pollutants.Provider}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality.Calculate.Algorithm}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&API.QWeather.Host="{{{API.QWeather.Host}}}"&API.QWeather.Token="{{{API.QWeather.Token}}}"&API.WAQI.Token="{{{API.WAQI.Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

📰 News.v1.configs.request = type=http-request, pattern="^https:\/\/news(-todayconfig)?-edge\.apple\.com\/v1\/configs(?:\?|$)", requires-body=1, script-path=https://github.com/NSRingo/News/releases/download/v3.2.1/request.bundle.js, argument=CountryCode="{{{CountryCode}}}"&NewsPlusUser="{{{NewsPlusUser}}}"&LogLevel="{{{LogLevel}}}"
📰 News.v1.search.request = type=http-request, pattern="^https:\/\/news-client-search\.apple\.com\/v1\/search(?:\?|$)", requires-body=0, script-path=https://github.com/NSRingo/News/releases/download/v3.2.1/request.bundle.js, argument=CountryCode="{{{CountryCode}}}"&NewsPlusUser="{{{NewsPlusUser}}}"&LogLevel="{{{LogLevel}}}"

📺 TV.uts.request = type=http-request, pattern="^https:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\/", requires-body=1, script-path=https://github.com/NSRingo/TV/releases/download/v3.4.4/request.bundle.js, argument=ThirdParty="{{{ThirdParty}}}"&isWorkaroundSSLPinning="{{{isWorkaroundSSLPinning}}}"&LogLevel="{{{LogLevel}}}"
📺 TV.uts.response = type=http-response, pattern="^https:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\/", requires-body=1, script-path=https://github.com/NSRingo/TV/releases/download/v3.4.4/response.bundle.js, argument=ThirdParty="{{{ThirdParty}}}"&isWorkaroundSSLPinning="{{{isWorkaroundSSLPinning}}}"&LogLevel="{{{LogLevel}}}"
