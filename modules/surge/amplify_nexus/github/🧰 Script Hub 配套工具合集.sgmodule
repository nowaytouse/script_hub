#!name=🧰 Script Hub 配套工具合集
#!desc=Script Hub 转换 · BoxJs · Sub-Store(β) · 节假日、网络与订阅流量面板\n\n【Bundled Modules】\n✦ 🧰 Script Hub 配套工具合集: Script Hub 转换 (script.hub) · BoxJs · Sub-Store(β)\n\n✦ 节假日信息: 显示节假日的信息\n\n✦ 网络信息 𝕏: 国内外 IP, 运营商, ASN, ORG, 位置, 策略; IPv6; 入口落地; 隐私; LAN; SSID. 自己设置对应域名的分流. 支持网络变化时进行查询通知. 提供 https://net-lsp-x.com 数据接口, 参数与模块参数相同. https://t.me/zhetengsha\n\n✦ 机场订阅信息: 显示机场剩余流量、流量使用情况、流量重置日期、以及套餐到期时间
#!author=@小白脸 @xream @keywos @ckyb, ChavyLeung, sub-store-org, Rabbit-Spec, Coldvvater
#!icon=https://raw.githubusercontent.com/Orz-3/mini/master/Color/Auto.png
#!category=『 🛠️ Amplify Nexus › 增幅枢纽 』
#!tag=ScriptHub, BoxJs, Sub-Store, 面板, 工具
#!date=2026-11-05 10:28:13
#!arguments=ability:http-client-policy,cronexp:55 23 * * *,sync:"Sub-Store Sync",timeout:900,engine:auto,produce:"# Sub-Store Produce",produce_cronexp:50 */6 * * *,sync_success_notify:false,produce_sub:"sub1,sub2",produce_col:"col1,col2",max_size:-1,cors:"https://sub-store.vercel.app,http://substore.stash,https://substore.stash",Notify:开启通知,DOMESTIC_IPv4:spcn,DOMESTIC_IPv4_KEY:若接口需要就填这里,DOMESTIC_IPv6:ddnspod,LANDING_IPv4:ipapi,LANDING_IPv4_KEY:若接口需要就填这里,LANDING_IPv6:ipsb,DNS:ali,FLAG:1,ASN:0,ORG:0,PRIVACY:0,LAN:0,SSID:0,IPv6:0,MASK:0,TIMEOUT:5,RETRIES:1,RETRY_DELAY:1,ENTRANCE_DELAY:0,EVENT_SCRIPT_NAME:网络信息变化,EVENT_DELAY:3,PANEL_NAME:网络信息面板,UPDATE-INTERVAL:-1,ICON:globe.asia.australia,ICON-COLOR:#6699FF,机场名称:airport,面板图标:airplane.departure,图标颜色:#157EFB,流量重置日期:1,套餐到期日子:2024-01-01,订阅链接:sub_link,面板刷新时间:3600
#!arguments-desc=[🧰 Script Hub 配套工具合集]\n[Sub-Store(β)]\n\n1️⃣ ability\n\n默认已开启测落地能力\n需要配合脚本操作\n如 https://raw.githubusercontent.com/Keywos/rule/main/cname.js\n填写任意其他值关闭\n\n2️⃣ cronexp\n\n同步配置定时任务\n默认为每天 23 点 55 分\n\n定时任务指定时将订阅/文件上传到私有 Gist. 在前端, 叫做 '同步' 或 '同步配置'\n\n3️⃣ sync\n\n自定义定时任务名\n便于在脚本编辑器中选择\n若设为 # 可取消定时任务\n\n4️⃣ timeout\n\n脚本超时, 单位为秒\n\n5️⃣ engine\n\n默认为自动使用 webview 引擎, 可设为指定 jsc, 但 jsc 容易爆内存\n\n6️⃣ produce\n\n自定义处理订阅的定时任务名\n一般用于定时处理耗时较长的订阅, 以更新缓存\n这样 Surge 中拉取的时候就能用到缓存, 不至于总是超时\n若设为 # 可取消此定时任务\n默认不开启\n\n7️⃣ produce_cronexp\n\n配置处理订阅的定时任务\n\n默认为每 6 小时\n\n8️⃣ sync_success_notify\n\n同步配置全部成功时是否发送完成通知\n默认为 true, 填 false/0/no/off 可关闭\n\n9️⃣ produce_sub\n\n自定义需定时处理的单条订阅名\n多个用 , 连接\n\n🔟 produce_col\n\n自定义需定时处理的组合订阅名\n多个用 , 连接\n\n1️⃣1️⃣ cors\n\n允许浏览器跨域访问 Sub-Store 后端的 origin. 默认为 https://sub-store.vercel.app,http://substore.stash,https://substore.stash. 多个用 , 连接. 设为 * 可恢复旧的任意来源访问行为, 存在钓鱼网站读取配置的风险\n\n⚠️ 注意: 是 名称(name) 不是 显示名称(displayName)\n如果名称需要编码, 请编码后再用 , 连接\n顺序: 并发执行单条订阅, 然后并发执行组合订阅\n\n[Script Hub: 重写 & 规则集转换]\nNotify:\nScriptHub通知设置, 可选 开启通知, 关闭通知, 跟随链接\n\n[网络信息 𝕏]\n完整说明: https://github.com/xream/scripts/blob/main/surge/modules/network-info/README.md\n\n1 为开启, 0 为关闭\n\n · [LAN]: 显示 LAN IP\n\n · [SSID]: 显示 SSID\n\n · [IPv6]: 显示 IPv6 地址\n\n · [MASK]: 打码 保护隐私\n\n · [DOMESTIC_IPv4]: 国内 IPv4 来源, 可选 spcn(请设置分流 DOMAIN-SUFFIX,speedtest.cn), cip, bilibili, zssq, edifier, 126, ipip, ip233, pingan, 163, qtfm, ipim(请设置分流 DOMAIN-SUFFIX,ip.im), youdao, netart, ali(将阿里云 IP 服务的 APPCODE 填到 DOMESTIC_IPv4_KEY)\n\n · [DOMESTIC_IPv4_KEY]: 若接口需要就填(多个 key 用 , 分隔)\n\n · [DOMESTIC_IPv6]: 国内 IPv6 来源, 可选 ddnspod, youdao, netart\n\n · [LANDING_IPv4]: 落地 IPv4 来源, 可选 ipapi, ipsb, ipwhois, ipapiis, ipinfo(将 token 填到 LANDING_IPv4_KEY)\n\n · [LANDING_IPv4_KEY]: 若接口需要就填(多个 key 用 , 分隔)\n\n · [LANDING_IPv6]: 落地 IPv6 来源, 可选 ipsb, ident, ipify\n\n · [DNS]: 解析域名, 可选 google, cf, ali, tencent\n\n · [ASN]: 显示 ASN 信息\n\n · [ORG]: 显示 ORG 信息\n\n · [PRIVACY]: 显示 Privacy/Security 等信息(仅 ipapiis)\n\n · [FLAG]: 是否显示国旗\n\n · [TIMEOUT]: 超时设置(单位: 秒)\n\n · [RETRIES]: 请求重试次数\n\n · [RETRY_DELAY]: 请求重试等待时间(单位: 秒)\n\n · [ENTRANCE_DELAY]: 查询落地之后紧接着查询入口可能会导致请求太频繁而风控\n可适当调节此延时(单位: 秒)\n\n · [EVENT_SCRIPT_NAME]: 网络变化时进行查询通知的脚本名称\n若要禁用此脚本, 请输入 #\n\n · [EVENT_DELAY]: 网络变化时, 延后查询信息(单位: 秒)\n\n · [PANEL_NAME]: 网络信息面板名称\n若要禁用此面板, 请输入 #\n\n · [UPDATE-INTERVAL]: 面板刷新时间\n您可以在这里指定一个小的时间（例如1），以使面板每次自动更新…\n(see upstream docs for full details)
#!homepage=https://script.hub
# Upstream modules merged by Script Hub (Rust)
# - Script Hub curated base: local:crates/processor/assets/DevTools.Base.sgmodule
# - Timecard: https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Module/Panel/Timecard/Moore/Timecard.sgmodule
# - net-lsp-x: https://raw.githubusercontent.com/xream/scripts/main/surge/modules/network-info/net-lsp-x.sgmodule
# - Sub_Info: https://raw.githubusercontent.com/Coldvvater/Mononoke/master/Surge/Module/Tool/Sub_Info.sgmodule

[General]


force-http-engine-hosts = %APPEND% boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net, script.hub, *.script.hub
[Script]
Rewrite: BoxJs              = type=http-request,pattern=^https?:\/\/(.+\.)?boxjs\.(com|net),script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/box/chavy.boxjs.js, requires-body=true, timeout=120
Sub-Store Core              = type=http-request,pattern=^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info))),script-path=https://raw.githubusercontent.com/nowaytouse/script_hub/master/modules/source/scripts/github_com_sub-store-org_sub-store-1.min.js,requires-body=true,timeout={{{timeout}}},ability="{{{ability}}}",engine={{{engine}}},max-size={{{max_size}}},argument="cors={{{cors}}}"
Sub-Store Simple            = type=http-request,pattern=^https?:\/\/sub\.store,script-path=https://raw.githubusercontent.com/nowaytouse/script_hub/master/modules/source/scripts/github_com_sub-store-org_sub-store-0.min.js,requires-body=true,timeout={{{timeout}}},engine={{{engine}}},max-size={{{max_size}}},argument="cors={{{cors}}}"
{{{sync}}}                  = type=cron,cronexp="{{{cronexp}}}",wake-system=1,timeout={{{timeout}}},script-path=https://raw.githubusercontent.com/nowaytouse/script_hub/master/modules/source/scripts/github_com_sub-store-org_cron-sync-artifacts.min.js,engine={{{engine}}},argument="sync_success_notify={{{sync_success_notify}}}"
{{{produce}}}               = type=cron,cronexp="{{{produce_cronexp}}}",wake-system=1,timeout={{{timeout}}},script-path=https://raw.githubusercontent.com/nowaytouse/script_hub/master/modules/source/scripts/github_com_sub-store-org_cron-sync-artifacts.min.js,engine={{{engine}}},argument="sub={{{produce_sub}}}&col={{{produce_col}}}"
Script Hub: 前端              = type=http-request, pattern=^https?:\/\/script\.hub\/($|edit\/|reload), script-path=https://raw.githubusercontent.com/nowaytouse/script_hub/master/modules/source/scripts/raw_githubusercontent_com_f59ef7_script-hub.js, timeout=300
Script Hub: 重写转换            = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module), script-path=https://raw.githubusercontent.com/nowaytouse/script_hub/master/modules/source/scripts/raw_githubusercontent_com_4fd0f5_Rewrite-Parser.js, timeout=300, argument=Notify={{{Notify}}}
Script Hub: 规则集转换           = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=rule-set, script-path=https://raw.githubusercontent.com/nowaytouse/script_hub/master/modules/source/scripts/raw_githubusercontent_com_0aa101_rule-parser.js, timeout=300, argument=Notify={{{Notify}}}
Script Hub: 脚本转换            = type=http-request, pattern=^https?:\/\/script\.hub\/convert\/, script-path=https://raw.githubusercontent.com/nowaytouse/script_hub/master/modules/source/scripts/raw_githubusercontent_com_95a370_script-converter.js, timeout=300

Timecard                    = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/smartmimi/conf/master/surge/timecard.js

# Request
网络信息请求                      = type=http-request,pattern=^https?:\/\/net-lsp-x\.com,script-path=https://raw.githubusercontent.com/xream/scripts/main/surge/modules/network-info/net-lsp-x.js,timeout=120
# Event
{{{EVENT_SCRIPT_NAME}}}     = type=event,event-name=network-changed,timeout=120,script-path=https://raw.githubusercontent.com/xream/scripts/main/surge/modules/network-info/net-lsp-x.js,argument="TYPE=EVENT&icon={{{ICON}}}&icon-color={{{ICON-COLOR}}}&LAN={{{LAN}}}&SSID={{{SSID}}}&IPv6={{{IPv6}}}&MASK={{{MASK}}}&DOMESTIC_IPv4={{{DOMESTIC_IPv4}}}&DOMESTIC_IPv6={{{DOMESTIC_IPv6}}}&LANDING_IPv4={{{LANDING_IPv4}}}&LANDING_IPv6={{{LANDING_IPv6}}}&PRIVACY={{{PRIVACY}}}&FLAG={{{FLAG}}}&ENTRANCE_DELAY={{{ENTRANCE_DELAY}}}&TIMEOUT={{{TIMEOUT}}}&EVENT_DELAY={{{EVENT_DELAY}}}&RETRIES={{{RETRIES}}}&RETRY_DELAY={{{RETRY_DELAY}}}&ASN={{{ASN}}}&ORG={{{ORG}}}&DOMESTIC_IPv4_KEY={{{DOMESTIC_IPv4_KEY}}}&LANDING_IPv4_KEY={{{LANDING_IPv4_KEY}}}"
# Panel
网络信息面板                      = type=generic,timeout=120,script-path=https://raw.githubusercontent.com/xream/scripts/main/surge/modules/network-info/net-lsp-x.js,argument="icon={{{ICON}}}&icon-color={{{ICON-COLOR}}}&LAN={{{LAN}}}&SSID={{{SSID}}}&IPv6={{{IPv6}}}&MASK={{{MASK}}}&DOMESTIC_IPv4={{{DOMESTIC_IPv4}}}&DOMESTIC_IPv6={{{DOMESTIC_IPv6}}}&LANDING_IPv4={{{LANDING_IPv4}}}&LANDING_IPv6={{{LANDING_IPv6}}}&PRIVACY={{{PRIVACY}}}&FLAG={{{FLAG}}}&ENTRANCE_DELAY={{{ENTRANCE_DELAY}}}&TIMEOUT={{{TIMEOUT}}}&EVENT_DELAY={{{EVENT_DELAY}}}&RETRIES={{{RETRIES}}}&RETRY_DELAY={{{RETRY_DELAY}}}&ASN={{{ASN}}}&ORG={{{ORG}}}&DOMESTIC_IPv4_KEY={{{DOMESTIC_IPv4_KEY}}}&LANDING_IPv4_KEY={{{LANDING_IPv4_KEY}}}"

sub_info                    = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/githubdulong/Script/master/sub_info_panel.js,argument=url={{{订阅链接}}}&reset_day={{{流量重置日期}}}&title={{{机场名称}}}&icon={{{面板图标}}}&color={{{图标颜色}}}&expire={{{套餐到期日子}}}


[Panel]
Timecard = script-name=Timecard,update-interval=3600

{{{PANEL_NAME}}} = script-name=网络信息面板,update-interval={{{UPDATE-INTERVAL}}}

SUB_INFO = script-name=sub_info,content="Loading…",update-interval={{{面板刷新时间}}}


[MITM]
hostname = %APPEND% -*.githubusercontent.com, -api.github.com, -github.com, *.boxjs.com, *.boxjs.net, *.script.hub, boxjs.com, boxjs.net, net-lsp-x.com, script.hub, sub.store
