#!name=🌟 AdBlock Helper
#!desc=追加 AliDNS DoH 与双栈引导；指定局域网名称、设备入口和私网反查交给当前系统 DNS。保留 Apple 关键服务与加密 DNS 的 MITM 排除，不改分流策略。
#!author=ScriptHub
#!category=『 🔝 Head Expanse › 首端扩域 』
#!tag=AdBlock, DNS, Apple Safety
#!version=2026.11.05

[General]
encrypted-dns-server = %APPEND% https://dns.alidns.com/dns-query

[Host]
# Local names selected from SukkaW/Surge (AGPL-3.0): https://ruleset.skk.moe/Modules/Rules/sukka_local_dns_mapping/lan_without_real_ip.conf
*.10.in-addr.arpa = server:system
*.127.in-addr.arpa = server:system
*.16.172.in-addr.arpa = server:system
*.168.192.in-addr.arpa = server:system
*.17.172.in-addr.arpa = server:system
