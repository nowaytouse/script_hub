#!name=PROMAX split · YouTube.Enhance.sgmodule
#!desc=从混合模块拆出的去广告行 4/5；解锁/增强仍留在原模块
#!author=ScriptHub-Automated
#!split-source=/Users/nyamiiko/Downloads/GitHub/script_hub/modules/surge(main)/amplify_nexus/YouTube.Enhance.sgmodule

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad data-type=text data="" status-code=200

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, -github.com, -api.github.com, -*.githubusercontent.com
