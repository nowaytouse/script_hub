#!name=12306去广告
#!desc=过滤12306应用内广告及开屏广告
#!author=RuCu6[https://github.com/RuCu6]
#!icon=https://cdn.jsdelivr.net/gh/luestr/IconResource@main/App_icon/120px/12306.png
#!category=『 🎯 Narrow Pierce › 窄域穿刺 』
#!openUrl=https://apps.apple.com/app/id564818797
#!tag=去广告
#!loon_version=3.3.9
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Rule]
DOMAIN,ad.12306.cn,DIRECT,extended-matching

[Script]
移除12306开屏广告 = type=http-request, pattern=^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$, script-path=https://cdn.jsdelivr.net/gh/nowaytouse/script_hub@master/modules/source/scripts/kelee_one_f2d80b_12306_remove_splashscreen_ads.js, requires-body=true

移除12306应用内广告 = type=http-request, pattern=^https:\/\/mobile\.12306\.cn\/otsmobile\/app\/mgs\/mgw\.htm$, script-path=https://cdn.jsdelivr.net/gh/nowaytouse/script_hub@master/modules/source/scripts/kelee_one_fbf1d3_12306_remove_ads.js

[MITM]
hostname = %APPEND% ad.12306.cn, mobile.12306.cn, -github.com, -api.github.com, -*.githubusercontent.com

