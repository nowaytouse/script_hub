AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, -github.com, -api.github.com, -*.githubusercontent.com
