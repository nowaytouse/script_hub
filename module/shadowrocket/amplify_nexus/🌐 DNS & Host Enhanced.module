# SECTION 3: Local Domains / LAN
# ⚠️ .local 域名 Surge 已默认特殊处理
# ⚠️ mDNS 特殊域名使用 force-syslib
*.local = server:system // Surge 已默认处理 .local
*.lan = server:system // 本地局域网
*.test = server:system // 测试域名
*.localhost = server:system // 本地主机
*.localdomain = server:system // 本地域名
_hotspot_.m2m = server:force-syslib // M2M routers at MiFi Hotspot (mDNS)
hotspot.cslwifi.com = server:force-syslib // csl Wi-Fi Hotspot (mDNS)

# SECTION 4: Router Admin Panel (Force System Library DNS)
# ⚠️ 本地路由器管理面板，依赖 mDNS/本地发现，必须用系统库
*.id.ui.direct = server:force-syslib // Ubiquiti Unifi Network App (mDNS)
amplifi.lan = server:force-syslib // Ubiquiti Amplifi Router (mDNS)
router.synology.com = server:force-syslib // Synology Router
sila.razer.com = server:force-syslib // Razer Sila Router
router.asus.com = server:force-syslib // Asus Router
routerlogin.net = server:force-syslib // Netgear Router
orbilogin.com = server:force-syslib // Netgear Orbi Router
www.LinksysSmartWiFi.com = server:force-syslib // Linksys Router
LinksysSmartWiFi.com = server:force-syslib // Linksys Router
instant.arubanetworks.com = server:force-syslib // Aruba Router
