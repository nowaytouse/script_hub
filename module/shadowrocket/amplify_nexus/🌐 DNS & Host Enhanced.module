# ═══════════════════════════════════════════════════════════════
*.didichuxing.com = server:https://dns.alidns.com/dns-query // 滴滴出行
*.didiglobal.com = server:https://dns.alidns.com/dns-query // 滴滴全球
*.udache.com = server:https://dns.alidns.com/dns-query // 滴滴代驾
*.xiaojukeji.com = server:https://dns.alidns.com/dns-query // 小桔科技

# ═══════════════════════════════════════════════════════════════
# SECTION 26: 哔哩哔哩主域 BiliBili (DNSPod DoH)
# （bilivideo.com CDN 分流详见 SECTION 16）
# ═══════════════════════════════════════════════════════════════
*.bilibili.com = server:https://doh.pub/dns-query // BiliBili
*.hdslb.com = server:https://doh.pub/dns-query // BiliBili 静态资源
*.biliimg.com = server:https://doh.pub/dns-query // BiliBili 图片
*.acgvideo.com = server:https://doh.pub/dns-query // BiliBili 视频

# ═══════════════════════════════════════════════════════════════
# SECTION 27: 银行/金融 Finance (DNSPod DoH)
# ═══════════════════════════════════════════════════════════════
*.icbc.com.cn = server:https://doh.pub/dns-query // 工商银行
*.ccb.com = server:https://doh.pub/dns-query // 建设银行
*.abchina.com = server:https://doh.pub/dns-query // 农业银行
*.boc.cn = server:https://doh.pub/dns-query // 中国银行
*.bankcomm.com = server:https://doh.pub/dns-query // 交通银行
*.cmbchina.com = server:https://doh.pub/dns-query // 招商银行
*.95516.com = server:https://doh.pub/dns-query // 银联
*.unionpay.com = server:https://doh.pub/dns-query // 银联
*.pingan.com = server:https://doh.pub/dns-query // 平安
*.pingan.com.cn = server:https://doh.pub/dns-query // 平安中国
*.cib.com.cn = server:https://doh.pub/dns-query // 兴业银行
*.spdb.com.cn = server:https://doh.pub/dns-query // 浦发银行

