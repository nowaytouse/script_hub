[Host]
# SECTION 3: Mainland DoH Steering RULE-SETs (Priority — matched first)
# Mainland domains must be at the top so they hit mainland DoH without
# falling through to the international global pool (which would be slow).
# [SR不支持RULE-SET] RULE-SET,https://fastly.jsdelivr.net/gh/nowaytouse/script_hub@master/ruleset/Sources/DNS_mapping/DNS_China_AliDNS.list,server:https://dns.alidns.com/dns-query
# [SR不支持RULE-SET] RULE-SET,https://fastly.jsdelivr.net/gh/nowaytouse/script_hub@master/ruleset/Sources/DNS_mapping/DNS_China_114.list,server:https://doh.pub/dns-query
# [SR不支持RULE-SET] RULE-SET,https://fastly.jsdelivr.net/gh/nowaytouse/script_hub@master/ruleset/Sources/DNS_mapping/DNS_China_ByteDance.list,server:https://dns.alidns.com/dns-query
# [SR不支持RULE-SET] RULE-SET,https://fastly.jsdelivr.net/gh/nowaytouse/script_hub@master/ruleset/Sources/DNS_mapping/DNS_China_360.list,server:https://doh.pub/dns-query
# Comprehensive mainland domain catch-all from Direct.list
DOMAIN-SET,https://raw.githubusercontent.com/nowaytouse/script_hub/master/ruleset/Surge(Shadowkroket)/Direct.list,server:https://doh.pub/dns-query
# Generic .cn TLD fallback — last resort for mainland domains
*.cn = server:https://dns.alidns.com/dns-query



# SECTION 5: Rule-Based DoH Steering (International Domains → International DoH)
# International domains are explicitly steered to international DoH to ensure
# they never hit the international-only global pool fallback (which would work
# but might be slower than targeted steering).
# Format: DOMAIN-SET,<ruleset_url>,server:https://<international_doh_server>

# Japan-routed domains (StreamJP, StreamKR, CDN, substore)
DOMAIN-SET,https://raw.githubusercontent.com/nowaytouse/script_hub/master/ruleset/Surge(Shadowkroket)/StreamJP.list,server:https://dns.google/dns-query
DOMAIN-SET,https://raw.githubusercontent.com/nowaytouse/script_hub/master/ruleset/Surge(Shadowkroket)/StreamKR.list,server:https://dns.google/dns-query
DOMAIN-SET,https://raw.githubusercontent.com/nowaytouse/script_hub/master/ruleset/Surge(Shadowkroket)/CDN.list,server:https://cloudflare-dns.com/dns-query
DOMAIN-SET,https://raw.githubusercontent.com/nowaytouse/script_hub/master/ruleset/Surge(Shadowkroket)/substore.list,server:https://dns.quad9.net/dns-query

# Taiwan/HK-routed domains (StreamHK, StreamTW)
