[Rule]
# High-Priority White-list (Prevent DNS failure)
# These domains are whitelisted from blocking to ensure stability.
# Final routing follows specialized rulesets.
DOMAIN,dns.alidns.com,DIRECT
DOMAIN,doh.pub,DIRECT
DOMAIN,dns.pub,DIRECT
DOMAIN,dot.pub,DIRECT
DOMAIN,doh.360.cn,DIRECT
DOMAIN,doh.dns.apple.com,DIRECT
# Block app-layer HTTPDNS first so apps cannot bypass the host steering above.
RULE-SET,https://fastly.jsdelivr.net/gh/nowaytouse/script_hub@master/ruleset/Surge%28Shadowkroket%29/HTTPDNS_Hijack.list,REJECT
# REJECT Rules (self-hosted canonical rebuild)
RULE-SET,https://fastly.jsdelivr.net/gh/nowaytouse/script_hub@master/ruleset/Surge%28Shadowkroket%29/AdBlock.list,REJECT,extended-matching,pre-matching,update-interval=86400,no-resolve
# REJECT-NO-DROP Rules (synced from skk upstream)
RULE-SET,https://fastly.jsdelivr.net/gh/nowaytouse/script_hub@master/ruleset/Surge%28Shadowkroket%29/skk_upstream/reject-no-drop.list,REJECT-NO-DROP,extended-matching,pre-matching,update-interval=86400,no-resolve
# REJECT-DROP Rules (synced from skk upstream)
RULE-SET,https://fastly.jsdelivr.net/gh/nowaytouse/script_hub@master/ruleset/Surge%28Shadowkroket%29/skk_upstream/reject-drop.list,REJECT-DROP,extended-matching,pre-matching,update-interval=86400,no-resolve
# BlockHttpDNS Rules (kept separate to preserve REJECT-DROP behavior)
RULE-SET,https://fastly.jsdelivr.net/gh/nowaytouse/script_hub@master/ruleset/Surge%28Shadowkroket%29/skk_upstream/BlockHttpDNS.list,REJECT-DROP,extended-matching,pre-matching,update-interval=86400,no-resolve

