#!name=🌐 mosdns DNS Integration
#!desc=Route all DNS queries to local mosdns (127.0.0.1:53) for dual-track resolution with multi-tier fallback.
#!author=nyamiiko
#!homepage=https://github.com/nowaytouse/script_hub
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Server.png
#!category=『 🛠️ Amplify Nexus › 增幅枢纽 』
#!version=2026.04.16f

[General]
# Route all DNS queries to local mosdns instance on standard port 53
# mosdns handles dual-track resolution with multi-tier fallback:
# - CN domains → Mainland DoH (AliDNS/DNSPod/360/Baidu/Volcengine) direct
# - International domains → International DoH (Cloudflare/Google/Quad9/NextDNS/AdGuard/Mullvad/etc.) via proxy
dns-server = 127.0.0.1, [::1]

# Keep these for mosdns bootstrap and fallback
use-local-host-item-for-proxy = false
encrypted-dns-follow-outbound-mode = false
hijack-dns = *:53
allow-dns-svcb = false
# allow-udp-proxy = false

[Rule]
# FORCE-DIRECT Bootstrap DNS to bypass ASN/Proxy filters
IP-CIDR,119.29.29.29/32,DIRECT,no-resolve
IP-CIDR,1.12.12.12/32,DIRECT,no-resolve
IP-CIDR,120.53.53.53/32,DIRECT,no-resolve
IP-CIDR,223.5.5.5/32,DIRECT,no-resolve
IP-CIDR,223.6.6.6/32,DIRECT,no-resolve
IP-CIDR,1.1.1.1/32,DIRECT,no-resolve
IP-CIDR,1.0.0.1/32,DIRECT,no-resolve
IP-CIDR,8.8.8.8/32,DIRECT,no-resolve
IP-CIDR,114.114.114.114/32,DIRECT,no-resolve
IP-CIDR,9.9.9.9/32,DIRECT,no-resolve
IP-CIDR6,2400:3200::1/128,DIRECT,no-resolve
IP-CIDR6,2402:4e00::/128,DIRECT,no-resolve
IP-CIDR6,2400:da00::6666/128,DIRECT,no-resolve
IP-CIDR6,2606:4700:4700::1111/128,DIRECT,no-resolve
IP-CIDR6,2001:4860:4860::8888/128,DIRECT,no-resolve

[Script]
DNS Guard Request = type=http-request, pattern=^https?:\/\/(httpdns|dns)\.(alicdn|aliyuncs|baidu|baidubce|bilivideo|meituan|jd|weixin\.qq|weibo|volcengineapi|yunxindns|calorietech|push\.oppomobile)\.(com|cn), script-path=https://fastly.jsdelivr.net/gh/nowaytouse/script_hub@master/scripts/dns/dns_guard.js, requires-body=0, timeout=10
DNS Guard HTTPDNS-IP = type=http-request, pattern=^https?:\/\/(203\.107\.1\.\d+|180\.76\.76\.200|119\.29\.29\.(98|99)|59\.111\.239\.(61|62)|101\.124\.19\.122|103\.224\.222\.208), script-path=https://fastly.jsdelivr.net/gh/nowaytouse/script_hub@master/scripts/dns/dns_guard.js, requires-body=0, timeout=10
DNS Guard Response = type=http-response, pattern=^https?:\/\/.*dns(-query|\/resolve|\.weixin|\.jd|\.weibo), script-path=https://fastly.jsdelivr.net/gh/nowaytouse/script_hub@master/scripts/dns/dns_guard.js, requires-body=1, max-size=65536, timeout=10
DoH Health Monitor = type=cron, cronexp=0 */6 * * *, wake-system=0, script-path=https://fastly.jsdelivr.net/gh/nowaytouse/script_hub@master/scripts/dns/doh_health.js, timeout=30

[MITM]
hostname = %APPEND% *.google.cn, *.google.com.hk, httpdns.*, dns.jd.com, dns.weixin.qq.com, dns.weibo.cn, -github.com, -api.github.com, -*.githubusercontent.com
