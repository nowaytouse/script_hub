# China ASN Priority
RULE-SET,https://raw.githubusercontent.com/nowaytouse/script_hub/main/ruleset/Surge(Shadowkroket)/ChinaASN.list,DIRECT
RULE-SET,https://raw.githubusercontent.com/nowaytouse/script_hub/main/ruleset/Surge(Shadowkroket)/GlobalASN.list,DIRECT

PROTOCOL,QUIC,REJECT-NO-DROP

# GEOIP Catch-All (放置于 ASN 规则之后、FINAL 之前)
GEOIP,CN,DIRECT,no-resolve

[Script]
# DNS Guard - HTTPDNS Interception (Script-level, more precise)
# ⚠️ 在URL层面拦截HTTPDNS请求 + 验证DNS响应防止投毒
DNS Guard Request = type=http-request, pattern=^https?:\/\/(httpdns|dns)\.(alicdn|aliyuncs|baidu|baidubce|bilivideo|meituan|jd|weixin\.qq|weibo|volcengineapi|yunxindns|calorietech|push\.oppomobile)\.(com|cn), script-path=https://raw.githubusercontent.com/nowaytouse/script_hub/master/scripts/dns/dns_guard.js, requires-body=0, timeout=10

DNS Guard HTTPDNS-IP = type=http-request, pattern=^https?:\/\/(203\.107\.1\.\d+|180\.76\.76\.200|119\.29\.29\.(98|99)|59\.111\.239\.(61|62)|101\.124\.19\.122|103\.224\.222\.208), script-path=https://raw.githubusercontent.com/nowaytouse/script_hub/master/scripts/dns/dns_guard.js, requires-body=0, timeout=10

DNS Guard Response = type=http-response, pattern=^https?:\/\/.*dns(-query|\/resolve|\.weixin|\.jd|\.weibo), script-path=https://raw.githubusercontent.com/nowaytouse/script_hub/master/scripts/dns/dns_guard.js, requires-body=1, max-size=65536, timeout=10

# DoH Health Monitor (每6小时检测一次)
DoH Health Monitor = type=cron, cronexp=0 */6 * * *, wake-system=0, script-path=https://raw.githubusercontent.com/nowaytouse/script_hub/master/scripts/dns/doh_health.js, timeout=30

[MITM]
hostname = %APPEND% *.google.cn, *.google.com.hk, *.zhihu.com, zhidao.baidu.com, httpdns.*, dns.jd.com, dns.weixin.qq.com, dns.weibo.cn, -github.com, -api.github.com, -*.githubusercontent.com
hostname-disabled = %INSERT% gateway.icloud.com, gateway.icloud.com.cn, weather-data.apple.com, buy.itunes.apple.com, sandbox.itunes.apple.com, upp.itunes.apple.com
