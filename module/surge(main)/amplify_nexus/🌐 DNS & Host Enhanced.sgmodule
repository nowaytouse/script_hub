[Rule]
# 🔒 Block 360 DNS from resolving international domains
# ⚠️ 防止 360 DoH 对外网域名进行中间人解析
DOMAIN,doh.360.cn,DIRECT
DOMAIN,dns.360.cn,DIRECT
# 阻断 360 安全组件对外网的 DNS 探针
DOMAIN-SUFFIX,so.360.cn,REJECT

